@echo off
rem ============================================================
rem  Compile the HTML Help project generated by javadoc.chm
rem  Run this file from its own folder (double click is fine).
rem ============================================================
cd /d "%~dp0"

if exist "hhc.exe" (
    echo Using the bundled hhc.exe ...
    start /wait "" "hhc.exe" "htmlhelp.hhp"
    goto check
)

echo Bundled hhc.exe not found, trying HTML Help Workshop ...
if exist "%ProgramFiles(x86)%\HTML Help Workshop\hhc.exe" (
    start /wait "" "%ProgramFiles(x86)%\HTML Help Workshop\hhc.exe" "htmlhelp.hhp"
    goto check
)
if exist "%ProgramFiles%\HTML Help Workshop\hhc.exe" (
    start /wait "" "%ProgramFiles%\HTML Help Workshop\hhc.exe" "htmlhelp.hhp"
    goto check
)

echo.
echo ERROR: hhc.exe was not found.
echo Install HTML Help Workshop, or copy hhc.exe next to this file.
pause
exit /b 1

:check
echo.
if exist "*.chm" (
    echo Done. The compiled CHM is in this folder:
    dir /b *.chm
) else (
    echo Compilation finished but no .chm was produced.
    echo Check the messages above for errors.
)
pause
